# Remove the question mark from the request but maintain the query string
RewriteEngine On

# Set the base directory path if your application is in a subdirectory
# Uncomment and adjust the line below if needed
# RewriteBase /your_subdirectory/public/
RewriteBase /

# Handle front controller pattern
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^(.*)$ index.php?$1 [L,QSA]

# PHP settings that might be needed on shared hosting
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_value max_execution_time 60
    php_value memory_limit 256M
</IfModule>
